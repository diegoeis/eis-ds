{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Geist",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Text voice: titles, body, task text. Open substitute for TE's proprietary grotesque."
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "SF Mono",
          "Menlo",
          "monospace"
        ],
        "$description": "Instrument voice: labels, numbers, dates, sources, navigation."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale.",
      "100": {
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "Labels."
      },
      "200": {
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Mono metadata, small UI."
      },
      "300": {
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Body and UI text."
      },
      "400": {
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$description": "Lead."
      },
      "500": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "Heading."
      },
      "600": {
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$description": "Large heading, metric on small screens."
      },
      "700": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Metric."
      },
      "800": {
        "$value": {
          "value": 56,
          "unit": "px"
        },
        "$description": "Display title."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": 300,
        "$description": "Display and metrics. Big and thin."
      },
      "regular": {
        "$value": 400,
        "$description": "Body."
      },
      "medium": {
        "$value": 500,
        "$description": "Labels, emphasis in mono."
      },
      "semibold": {
        "$value": 600,
        "$description": "Brand mark only."
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1,
        "$description": "Display, metrics, single-line labels."
      },
      "snug": {
        "$value": 1.25,
        "$description": "Headings."
      },
      "normal": {
        "$value": 1.45,
        "$description": "Body and multi-line text."
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": {
          "value": -1.5,
          "unit": "px"
        },
        "$description": "Display and metrics."
      },
      "none": {
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "Default."
      },
      "wide": {
        "$value": {
          "value": 0.88,
          "unit": "px"
        },
        "$description": "Uppercase mono labels (0.08em at 11px)."
      }
    }
  }
}
